PORT=4000
NODE_ENV=development

# Transactions need a replica set: use MongoDB Atlas, or `docker compose up -d` from the repo root.
MONGO_URI=mongodb://127.0.0.1:27017/techbreak?directConnection=true

JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Comma-separated list, or * to allow any origin in development
CORS_ORIGINS=*

# Google Sign-In (OAuth client ID used by the Flutter app)
GOOGLE_CLIENT_ID=

# Firebase service account JSON on one line. Leave empty to log pushes instead of sending them.
FIREBASE_SERVICE_ACCOUNT=

# Token economy tuning
DAILY_EARN_CAP=400

# Password for the demo user created by `npm run seed`
SEED_DEMO_PASSWORD=techbreak-demo
